# portal-backend/.env.example
# Copy to .env — NEVER commit .env to git
#
# Generate JWT_SECRET with:
#   openssl rand -hex 64

NODE_ENV=production
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://labportal:CHANGE_ME@localhost:5432/labportal
DATABASE_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_64
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_URL=https://172.16.0.10:8006
PROXMOX_TOKEN_ID=terraform@pve!terraform
PROXMOX_TOKEN_SECRET=CHANGE_ME
PROXMOX_NODE=pve01
PROXMOX_INSECURE=true

# ── Portal ────────────────────────────────────────────────────────────────────
# URL of the portal-ui (for CORS allow-origin)
PORTAL_ORIGIN=http://172.16.0.10:3000
# Set to 'true' to skip instructor approval for student registrations
AUTO_APPROVE_STUDENTS=false
MAX_STUDENT_SLOTS=20
# Absolute path to the repo root (for Terraform CLI calls)
REPO_ROOT=/opt/vuln-lab

# ── Email (for password reset) ────────────────────────────────────────────────
# Set EMAIL_MODE=console to print reset links to server log instead of sending
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=lab@vuln-lab.local

# ── Initial admin password (used by seed script only) ─────────────────────────
# CHANGE THIS IMMEDIATELY after first login
ADMIN_PASSWORD=ChangeMe123!@#
