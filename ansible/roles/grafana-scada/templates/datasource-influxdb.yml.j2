apiVersion: 1
datasources:
  - name: InfluxDB-SCADA
    type: influxdb
    access: proxy
    url: {{ grafana_influxdb_url }}
    jsonData:
      version: Flux
      organization: {{ grafana_influxdb_org }}
      defaultBucket: {{ grafana_influxdb_bucket }}
    secureJsonData:
      token: {{ grafana_influxdb_token }}
    isDefault: true
    editable: true
