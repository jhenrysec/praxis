# terraform/providers.tf
# Root-level provider configuration
# Each scenario directory also has its own providers.tf (generated by INFRA_AGENT)
# Updated: see CHANGELOG.md

terraform {
  required_version = ">= 1.14.0"
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = ">= 0.99.0, < 1.0.0"
    }
  }
}

# Provider is configured in each scenario via environment variables:
#   PROXMOX_VE_ENDPOINT
#   PROXMOX_VE_API_TOKEN_ID
#   PROXMOX_VE_API_TOKEN_SECRET
#   PROXMOX_VE_INSECURE
#
# See scripts/lab-env.sh for the template.
