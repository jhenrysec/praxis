{
  "model": "claude-opus-4-6",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": ".claude/memory",

  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(terraform:*)",
      "Bash(packer:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-lint:*)",
      "Bash(ansible-galaxy:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(go:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(zfs:*)",
      "Bash(zpool:*)",
      "Bash(pvesh:*)",
      "Bash(pveum:*)",
      "Bash(qm:*)",
      "Bash(pveversion:*)",
      "Bash(ifreload:*)",
      "Bash(ip:*)",
      "Bash(ss:*)",
      "Bash(systemctl:*)",
      "Bash(apt:*)",
      "Bash(dpkg:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(zip:*)",
      "Bash(tar:*)",
      "Bash(echo:*)",
      "Bash(tee:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(pm2:*)",
      "Bash(psql:*)",
      "Bash(pg_isready:*)",
      "Bash(openssl:*)",
      "Bash(nginx:*)",
      "Bash(tsx:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)"
    ]
  },

  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30,

  "env": {
    "INFRA_CONTEXT": "proxmox-lab",
    "LAB_MGMT_NET": "172.16.0.0/24",
    "LAB_RED_NET": "10.10.x.0/24",
    "LAB_BLUE_NET": "10.10.x.0/24",
    "LAB_OT_NET": "192.168.x.0/24",
    "PROXMOX_HOST": "172.16.0.10",
    "PORTAL_URL": "http://172.16.0.10:3000",
    "PORTAL_API": "http://172.16.0.10:4000",
    "MAX_STUDENT_SLOTS": "20",
    "TERRAFORM_MIN_VERSION": "1.9.0",
    "PACKER_MIN_VERSION": "1.11.0"
  }
}
